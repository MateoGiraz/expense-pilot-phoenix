# Production Environment Configuration

# Main PostgreSQL Database
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=secure_prod_password
POSTGRES_DB=expense_pilot_prod
POSTGRES_PORT=5432

# Auth Service PostgreSQL Database
AUTH_POSTGRES_USER=auth_prod_user
AUTH_POSTGRES_PASSWORD=secure_auth_password
AUTH_POSTGRES_DB=auth_service_prod
AUTH_POSTGRES_PORT=5433

# Database URLs for Services
PHOENIX_DATABASE_URL=postgresql://prod_user:secure_prod_password@postgres:5432/expense_pilot_prod
AUTH_DATABASE_URL=postgresql://auth_prod_user:secure_auth_password@auth-postgres:5432/auth_service_prod
EXPENSES_DATABASE_URL=postgresql://prod_user:secure_prod_password@postgres:5432/expenses_service_prod
AUDIT_DATABASE_URL=postgresql://prod_user:secure_prod_password@postgres:5432/audit_service_prod

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://auth-service:5439
AUDIT_SERVICE_URL=http://audit-service:3000/api/v1
EXPENSES_SERVICE_URL=http://expenses-service:4001

# Service Ports
PHOENIX_PORT=4000
AUTH_SERVICE_PORT=5439
EXPENSES_SERVICE_PORT=4001
AUDIT_SERVICE_PORT=3000
NOTIFICATION_SERVICE_PORT=8000

# Phoenix Configuration
PHX_HOST=your-production-domain.com
SECRET_KEY_BASE=your-super-secure-secret-key-base-64-chars-minimum

# Rails Configuration
RAILS_SECRET_KEY_BASE=your-rails-secret-key-base

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters-long

# AWS Configuration (for notification service)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account/queue
AWS_SES_FROM_EMAIL=noreply@your-domain.com 