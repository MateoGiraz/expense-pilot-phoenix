<.header>
  New Area
  <:subtitle>Create a new company area or department</:subtitle>
</.header>

<.simple_form :let={f} for={@changeset} action={~p"/areas"}>
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>
  
  <.input field={f[:name]} type="text" label="Name" required />
  <.input field={f[:description]} type="textarea" label="Description" rows="3" />
  
  <:actions>
    <.button phx-disable-with="Creating...">Create Area</.button>
  </:actions>
</.simple_form>

<.back navigate={~p"/areas"}>Back to areas</.back> 