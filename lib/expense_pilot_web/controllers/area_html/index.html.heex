<.header>
  Company Areas
  <:subtitle>Manage company areas and departments</:subtitle>
  <:actions :if={ExpensePilot.Accounts.User.is_superadmin?(@current_user)}>
    <.link navigate={~p"/areas/new"}>
      <.button>New Area</.button>
    </.link>
  </:actions>
</.header>

<div class="mt-6">
  <div class="bg-white shadow overflow-hidden sm:rounded-md">
    <ul role="list" class="divide-y divide-gray-200">
      <%= for area <- @areas do %>
        <li>
          <div class="px-4 py-4 sm:px-6">
            <div class="flex items-center justify-between">
              <div class="flex-1 min-w-0">
                <.link navigate={~p"/areas/#{area}"} class="block hover:text-indigo-700">
                  <p class="text-sm font-medium text-indigo-600 truncate">
                    <%= area.name %>
                  </p>
                  <p class="mt-2 flex items-center text-sm text-gray-500">
                    <%= if area.description do %>
                      <span class="truncate"><%= area.description %></span>
                    <% else %>
                      <span class="truncate italic">No description</span>
                    <% end %>
                  </p>
                </.link>
              </div>
              <div class="flex-shrink-0 flex gap-2">
                <.link navigate={~p"/areas/#{area}"}>
                  <.button>View</.button>
                </.link>
                <%= if ExpensePilot.Accounts.User.is_superadmin?(@current_user) do %>
                  <.link navigate={~p"/areas/#{area}/edit"}>
                    <.button>Edit</.button>
                  </.link>
                  <.link
                    href={~p"/areas/#{area}"}
                    method="delete"
                    data-confirm="Are you sure you want to delete this area? This action cannot be undone."
                  >
                    <.button>Delete</.button>
                  </.link>
                <% end %>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <%= if @areas == [] do %>
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No areas</h3>
      <p class="mt-1 text-sm text-gray-500">Get started by creating your first company area.</p>
      <%= if ExpensePilot.Accounts.User.is_superadmin?(@current_user) do %>
        <div class="mt-6">
          <.link navigate={~p"/areas/new"}>
            <.button>New Area</.button>
          </.link>
        </div>
      <% end %>
    </div>
  <% end %>
</div> 