<.header>
  <%= @area.name %>
  <:subtitle>Area details</:subtitle>
  <:actions :if={ExpensePilot.Accounts.User.is_superadmin?(@current_user)}>
    <.link navigate={~p"/areas/#{@area}/edit"}>
      <.button>Edit area</.button>
    </.link>
  </:actions>
</.header>

<div class="mt-6 border-t border-gray-100">
  <dl class="divide-y divide-gray-100">
    <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
      <dt class="text-sm font-medium leading-6 text-gray-900">Name</dt>
      <dd class="mt-1 text-sm leading-6 text-gray-700 sm:col-span-2 sm:mt-0">
        <%= @area.name %>
      </dd>
    </div>
    <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
      <dt class="text-sm font-medium leading-6 text-gray-900">Description</dt>
      <dd class="mt-1 text-sm leading-6 text-gray-700 sm:col-span-2 sm:mt-0">
        <%= if @area.description do %>
          <%= @area.description %>
        <% else %>
          <span class="italic text-gray-500">No description provided</span>
        <% end %>
      </dd>
    </div>
    <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
      <dt class="text-sm font-medium leading-6 text-gray-900">Created</dt>
      <dd class="mt-1 text-sm leading-6 text-gray-700 sm:col-span-2 sm:mt-0">
        <%= Calendar.strftime(@area.inserted_at, "%B %d, %Y at %I:%M %p") %>
      </dd>
    </div>
    <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
      <dt class="text-sm font-medium leading-6 text-gray-900">Last updated</dt>
      <dd class="mt-1 text-sm leading-6 text-gray-700 sm:col-span-2 sm:mt-0">
        <%= Calendar.strftime(@area.updated_at, "%B %d, %Y at %I:%M %p") %>
      </dd>
    </div>
  </dl>
</div>

<div class="mt-6 flex items-center justify-between">
  <.back navigate={~p"/areas"}>Back to areas</.back>
  
  <%= if ExpensePilot.Accounts.User.is_superadmin?(@current_user) do %>
    <.link
      href={~p"/areas/#{@area}"}
      method="delete"
      data-confirm="Are you sure you want to delete this area? This action cannot be undone."
    >
      <.button>Delete Area</.button>
    </.link>
  <% end %>
</div> 