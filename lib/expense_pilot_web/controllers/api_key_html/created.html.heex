<.header>
  API Key Created
  <:subtitle>Your new API key has been generated</:subtitle>
</.header>

<div class="bg-yellow-50 border border-yellow-200 p-6 rounded-lg mb-6 mt-2">
  <p class="text-yellow-800 font-semibold mb-2">⚠️ Important</p>
  <p class="text-yellow-700 mb-4">This is the only time your API key will be shown. Please save it securely as you won't be able to see it again.</p>
  
  <div class="bg-white border border-yellow-300 p-4 rounded-md mb-4">
    <p class="font-mono text-sm break-all"><%= @api_key.key %></p>
  </div>
  
  <button id="copy-button" class="bg-white border border-yellow-300 text-yellow-700 py-2 px-4 rounded hover:bg-yellow-100 transition" 
    onclick="copyToClipboard()">
    Copy to clipboard
  </button>
</div>

<.link navigate={~p"/admin/api-keys"} class="text-sm font-semibold">
  &larr; Back to API Keys
</.link>

<script>
  function copyToClipboard() {
    const apiKey = document.querySelector('.font-mono').textContent;
    navigator.clipboard.writeText(apiKey).then(() => {
      const button = document.getElementById('copy-button');
      const originalText = button.textContent;
      button.textContent = 'Copied!';
      setTimeout(() => {
        button.textContent = originalText;
      }, 2000);
    });
  }
</script> 