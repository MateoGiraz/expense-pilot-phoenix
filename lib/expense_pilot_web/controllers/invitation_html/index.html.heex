<.header>
  User Invitations
  <:actions>
    <.link href={~p"/admin/invitations/new"}>
      <.button>New Invitation</.button>
    </.link>
  </:actions>
</.header>

<div class="mt-6">
  <%= if Enum.empty?(@pending_invitations) do %>
    <div class="bg-white shadow-md rounded-lg p-6 text-center">
      <p class="text-gray-500">No pending invitations.</p>
      <p class="text-sm text-gray-500 mt-2">Invite users by clicking the "New Invitation" button above.</p>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full bg-white shadow-md rounded-lg">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sent At</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <%= for invitation <- @pending_invitations do %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= invitation.email %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= if invitation.invitation_sent_at do %>
                  <%= Calendar.strftime(invitation.invitation_sent_at, "%b %d, %Y at %H:%M") %>
                <% else %>
                  <span class="text-gray-400 italic">Not sent yet</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <.form :let={_f} for={%{}} as={:invitation} action={~p"/admin/invitations/#{invitation.id}/resend"} method="post" class="inline">
                  <.button type="submit" class="text-indigo-600 hover:text-indigo-900">Resend</.button>
                </.form>
                
                <.link 
                  href={~p"/admin/invitations/#{invitation.id}"}
                  method="delete"
                  data-confirm="Are you sure you want to cancel this invitation?"
                  class="ml-3 text-red-600 hover:text-red-900"
                >
                  Cancel
                </.link>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  
  <div class="bg-white shadow-md rounded-lg p-6 mb-6 mt-8">
    <h3 class="text-lg font-medium mb-4">How to invite users</h3>
    <ol class="list-decimal ml-6 space-y-2 text-sm text-gray-700">
      <li>Click on "New Invitation" button</li>
      <li>Enter the email address of the person you want to invite</li>
      <li>Select an area (optional)</li>
      <li>Click "Send Invitation" to email them a link to join</li>
    </ol>
  </div>
</div> 