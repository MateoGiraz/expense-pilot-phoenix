<a>
  <header class="top-header">
</header>

<div class="error">
  <!-- Dust particles -->
  <div>
    <div class="starsec"></div>
    <div class="starthird"></div>
    <div class="starfourth"></div>
    <div class="starfifth"></div>
  </div>

  <!-- Lamp -->
  <div class="lamp__wrap">
    <div class="lamp">
      <div class="cable"></div>
      <div class="cover"></div>
      <div class="in-cover">
        <div class="bulb"></div>
      </div>
      <div class="light"></div>
    </div>
  </div>

  <!-- Content -->
  <div class="error__content">
    <div class="error__message message">
      <h1 class="message__title">404</h1>
      <p class="message__text">We're sorry, the page you were looking for isn't found here. The link you followed may either be broken or no longer exists.</p>
    </div>
    <div class="error__nav e-nav">
      <.link navigate={~p"/"} class="e-nav__link">
        Return to Dashboard
      </.link>
    </div>
  </div>
</div>

  </a>