<.header>
  Audit Log Details
  <:subtitle>View detailed information about this activity</:subtitle>
  <:actions>
    <.link navigate={~p"/audit-logs"}>
      <.button>Back to Audit Logs</.button>
    </.link>
  </:actions>
</.header>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
  <div class="col-span-2">
    <div class="bg-white shadow rounded-lg p-6">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h3 class="text-xl font-semibold">
            <span class={
              case @log.action do
                "create" -> "bg-green-100 text-green-800"
                "update" -> "bg-blue-100 text-blue-800"
                "delete" -> "bg-red-100 text-red-800"
                _ -> "bg-gray-100 text-gray-800"
              end
              <> " px-2 py-1 rounded text-xs font-semibold mr-2"
            }>
              <%= String.upcase(@log.action) %>
            </span>
            <%= String.upcase(@log.resource_type) %> #<%= @log.resource_id %>
          </h3>
          <p class="text-gray-600 mt-2">
            Performed by <%= if @log.user, do: @log.user.email, else: "System" %> on <%= Calendar.strftime(@log.inserted_at, "%d/%m/%Y %H:%M") %>
          </p>
        </div>
      </div>

      <div class="mt-6">
        <h4 class="text-lg font-semibold mb-4">Changes</h4>
        <%= try do %>
          <%= case @log.action do %>
            <% "create" -> %>
              <div class="bg-gray-50 rounded-lg p-4">
                <pre class="text-sm"><%= Jason.encode!(@log.data, pretty: true) %></pre>
              </div>
            <% "update" -> %>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <h5 class="text-sm font-semibold text-gray-500 mb-2">Previous Values</h5>
                  <div class="bg-gray-50 rounded-lg p-4">
                    <%= if is_map(@log.data) and (Map.has_key?(@log.data, :old) or Map.has_key?(@log.data, "old")) do %>
                      <pre class="text-sm"><%= 
                      if Map.has_key?(@log.data, :old) do
                        Jason.encode!(@log.data.old, pretty: true)
                      else
                        Jason.encode!(@log.data["old"], pretty: true)
                      end
                      %></pre>
                    <% else %>
                      <p class="text-sm text-gray-500">Previous values not available</p>
                    <% end %>
                  </div>
                </div>
                <div>
                  <h5 class="text-sm font-semibold text-gray-500 mb-2">New Values</h5>
                  <div class="bg-gray-50 rounded-lg p-4">
                    <%= if is_map(@log.data) and (Map.has_key?(@log.data, :new) or Map.has_key?(@log.data, "new")) do %>
                      <pre class="text-sm"><%= 
                      if Map.has_key?(@log.data, :new) do
                        Jason.encode!(@log.data.new, pretty: true) 
                      else
                        Jason.encode!(@log.data["new"], pretty: true)
                      end
                      %></pre>
                    <% else %>
                      <p class="text-sm text-gray-500">New values not available</p>
                    <% end %>
                  </div>
                </div>
              </div>
            <% "delete" -> %>
              <div class="bg-gray-50 rounded-lg p-4">
                <pre class="text-sm"><%= Jason.encode!(@log.data, pretty: true) %></pre>
              </div>
            <% _ -> %>
              <div class="bg-gray-50 rounded-lg p-4">
                <pre class="text-sm"><%= Jason.encode!(@log.data, pretty: true) %></pre>
              </div>
          <% end %>
        <% rescue 
          e -> %>
          <div class="bg-red-100 rounded-lg p-4">
            <p class="text-red-700">Unable to display data: <%= inspect(e) %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  
  <div class="bg-white shadow rounded-lg p-6">
    <h3 class="text-lg font-semibold mb-4">Activity Information</h3>
    <ul class="space-y-3">
      <li class="flex justify-between">
        <span class="text-gray-600">Action</span>
        <span class={
          case @log.action do
            "create" -> "text-green-600"
            "update" -> "text-blue-600"
            "delete" -> "text-red-600"
            _ -> "text-gray-600"
          end
          <> " font-semibold"
        }>
          <%= String.upcase(@log.action) %>
        </span>
      </li>
      <li class="flex justify-between">
        <span class="text-gray-600">Resource Type</span>
        <span class="font-semibold"><%= String.upcase(@log.resource_type) %></span>
      </li>
      <li class="flex justify-between">
        <span class="text-gray-600">Resource ID</span>
        <span class="font-semibold">#<%= @log.resource_id %></span>
      </li>
      <li class="flex justify-between">
        <span class="text-gray-600">User</span>
        <span><%= if @log.user, do: @log.user.email, else: "System" %></span>
      </li>
      <li class="flex justify-between">
        <span class="text-gray-600">Date</span>
        <span><%= Calendar.strftime(@log.inserted_at, "%d/%m/%Y %H:%M") %></span>
      </li>
    </ul>
  </div>
</div> 