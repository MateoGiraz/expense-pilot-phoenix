<.header>
  Category: <%= @category.name %>
  <:subtitle>Category details</:subtitle>
  <:actions>
    <.link navigate={~p"/categories/#{@category}/edit"}>
      <.button>Edit Category</.button>
    </.link>
  </:actions>
</.header>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
  <div class="col-span-2">
    <div class="bg-white shadow rounded-lg p-6">
      <div class="mb-4">
        <h3 class="text-xl font-semibold"><%= @category.name %></h3>
        <p class="text-gray-600 mt-2"><%= @category.description %></p>
      </div>
      
      <div class="mt-6">
        <h4 class="text-lg font-semibold mb-2">Expense Limit</h4>
        <%= if @category.expense_limit do %>
          <div class="text-2xl font-bold text-emerald-600">
            <%= @category.expense_limit %>
          </div>
        <% else %>
          <div class="text-gray-500 italic">
            No expense limit set for this category
          </div>
        <% end %>
      </div>
    </div>
  </div>
  
  <div class="bg-white shadow rounded-lg p-6">
    <h3 class="text-lg font-semibold mb-4">Category Information</h3>
    <ul class="space-y-3">
      <li class="flex justify-between">
        <span class="text-gray-600">Created</span>
        <span><%= Calendar.strftime(@category.inserted_at, "%d/%m/%Y") %></span>
      </li>
      <li class="flex justify-between">
        <span class="text-gray-600">Last Updated</span>
        <span><%= Calendar.strftime(@category.updated_at, "%d/%m/%Y") %></span>
      </li>
    </ul>
    
    <div class="mt-6 pt-6 border-t border-gray-200">
      <.link href={~p"/categories/#{@category}"} method="delete" data-confirm="Are you sure you want to delete this category?" class="flex items-center text-red-600 hover:text-red-800">
        <.icon name="hero-trash" class="w-5 h-5 mr-2" />
        <span>Delete this category</span>
      </.link>
    </div>
  </div>
</div>

<.back navigate={~p"/categories"} class="mt-6">Back to categories</.back> 